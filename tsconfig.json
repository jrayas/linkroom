{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2021",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "importHelpers": false,
    "allowSyntheticDefaultImports": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
