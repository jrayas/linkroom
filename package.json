{
	"name": "linkroom",
	"version": "0.1.1",
	"description": "Browse the notes linked to and from the active note on a calm, full-page grid.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint . && stylelint --max-warnings 0 styles.css",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"vault:create": "node scripts/vault-create.mjs",
		"debug:launch": "node scripts/debug-launch.mjs",
		"debug": "node scripts/debug.mjs",
		"e2e": "node scripts/e2e.mjs",
		"e2e:mobile": "node scripts/e2e-mobile.mjs",
		"lint:css": "stylelint --max-warnings 0 styles.css"
	},
	"author": "Anthirayas",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@types/node": "^22.0.0",
		"esbuild": "0.28.2",
		"eslint": "9.39.4",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "^16.0.0",
		"jiti": "^2.4.0",
		"obsidian": "1.14.4",
		"stylelint": "17.16.0",
		"stylelint-no-unsupported-browser-features": "8.1.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.2",
		"vitest": "5.0.5"
	}
}
